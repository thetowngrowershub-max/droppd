# Postgres connection string. Local dev via `docker compose up -d` (see docker-compose.yml)
DATABASE_URL="postgresql://droppd:droppd@localhost:5432/droppd?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="30d"

# SMS OTP provider (Termii is widely used for Nigerian numbers). Leave unset in
# dev — see src/services/otp.ts, which logs the code to the console instead.
TERMII_API_KEY=
TERMII_SENDER_ID="droppd"

# Push notifications — Firebase Cloud Messaging (FCM)
# Path to a Firebase service-account JSON key, or set FIREBASE_SERVICE_ACCOUNT_JSON
# with the JSON content inline (e.g. in a hosting provider's secret manager).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Payments (Paystack recommended for NGN — cards, bank transfer, USSD)
PAYSTACK_SECRET_KEY=
